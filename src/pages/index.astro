---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const topics = [
  { name: 'Blockchain Nodes', icon: '⛓️', description: 'Running validator nodes, RPC endpoints, and consensus infrastructure' },
  { name: 'Linux VPS', icon: '🐧', description: 'Server administration, hardening, and performance optimization' },
  { name: 'Docker', icon: '🐳', description: 'Containerization, orchestration, and production deployment' },
  { name: 'AI Agents', icon: '🤖', description: 'Autonomous agents, LLM integration, and intelligent automation' },
  { name: 'Bug Bounty', icon: '🐛', description: 'Security research, vulnerability hunting, and responsible disclosure' },
  { name: 'Rust', icon: '🦀', description: 'Systems programming, memory safety, and high-performance applications' },
  { name: 'Golang', icon: '🔷', description: 'Concurrent programming, microservices, and cloud-native tools' },
  { name: 'Cloudflare', icon: '☁️', description: 'CDN, security, edge computing, and network optimization' },
];
---

<BaseLayout title="Hilmall Cloud" description="Technical insights on AI infrastructure, bug bounty, blockchain, Linux VPS, and modern DevOps. Written by practitioners, for practitioners.">
  <Header />
  <main class="flex-1 bg-dark">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-dark to-dark"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
            Deep Technical Content for
            <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
              Infrastructure Engineers
            </span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-300">
            From blockchain node operations to bug bounty hunting, from Rust systems programming to AI agent deployment. 
            Real-world guides written by engineers who run production infrastructure.
          </p>
          <div class="mt-10 flex items-center justify-center gap-4">
            <a
              href="/blog"
              class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 hover:bg-primary-dark transition-colors"
            >
              Read the Blog
            </a>
            <a
              href="/resources"
              class="rounded-lg border border-dark-border px-6 py-3 text-sm font-semibold text-white hover:bg-white/5 transition-colors"
            >
              View Resources
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Topics Grid -->
    <section class="border-t border-dark-border bg-dark-card">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white mb-8">What We Cover</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {topics.map((topic) => (
            <div class="rounded-xl border border-dark-border bg-dark p-6 hover:border-primary/50 transition-colors">
              <div class="text-3xl mb-3">{topic.icon}</div>
              <h3 class="font-semibold text-white mb-2">{topic.name}</h3>
              <p class="text-sm text-gray-400">{topic.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Latest Posts -->
    <section class="border-t border-dark-border">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-bold text-white">Latest Articles</h2>
          <a href="/blog" class="text-primary hover:text-primary-dark text-sm font-medium">
            View all →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group rounded-xl border border-dark-border bg-dark-card p-6 hover:border-primary/50 transition-colors">
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary">{tag}</span>
                ))}
              </div>
              <h3 class="text-lg font-semibold text-white group-hover:text-primary transition-colors mb-2">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="text-sm text-gray-400 line-clamp-2 mb-4">{post.data.description}</p>
              <time class="text-xs text-gray-500" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-dark-border bg-gradient-to-r from-primary/10 to-accent/10">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-white mb-4">Powered by Evolution Host</h2>
        <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
          Our infrastructure runs on Evolution Host's high-performance VPS. Reliable, affordable, and perfect for blockchain nodes, Docker workloads, and AI applications.
        </p>
        <a
          href="/partners"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark font-medium"
        >
          Learn more about our infrastructure →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
