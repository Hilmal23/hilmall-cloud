---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Content',
    links: [
      { href: '/blog', label: 'Blog' },
      { href: '/resources', label: 'Resources' },
      { href: '/partners', label: 'Partners' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
    ],
  },
];

const topics = [
  'Blockchain Nodes',
  'Linux VPS',
  'Docker',
  'AI Agents',
  'Bug Bounty',
  'Rust',
  'Golang',
  'Cloudflare',
];
---

<footer class="border-t border-dark-border bg-dark-card">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-white">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-accent">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span>Hilmall<span class="text-accent">.cloud</span></span>
        </a>
        <p class="text-sm text-gray-400">
          Technical content about AI infrastructure, bug bounty, blockchain, and modern DevOps. Written by practitioners, for practitioners.
        </p>
        <div class="flex gap-4">
          <a href="https://github.com/hilmall" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">
            <span class="sr-only">GitHub</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://twitter.com/hilmall" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Footer Links -->
      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300">{section.title}</h3>
          <ul class="mt-4 space-y-2">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Topics -->
    <div class="mt-8 border-t border-dark-border pt-8">
      <h4 class="text-sm font-semibold text-gray-300 mb-3">Topics we cover</h4>
      <div class="flex flex-wrap gap-2">
        {topics.map((topic) => (
          <span class="rounded-full bg-dark-border px-3 py-1 text-xs text-gray-400">{topic}</span>
        ))}
      </div>
    </div>

    <div class="mt-8 border-t border-dark-border pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} Hilmall Cloud. All rights reserved.
      </p>
      <p class="text-sm text-gray-500">
        Powered by <a href="https://evolution-host.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Evolution Host</a>
      </p>
    </div>
  </div>
</footer>
